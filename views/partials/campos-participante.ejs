<div class="row g-3 mb-3">
  <div class="col-md-6">
    <label for="nome" class="form-label fw-semibold">Nome *</label>
    <input id="nome" name="nome" type="text" class="form-control" maxlength="120" required value="<%= participante.nome || '' %>">
  </div>
  <div class="col-md-6">
    <label for="nome_artistico" class="form-label fw-semibold">Nome artístico</label>
    <input id="nome_artistico" name="nome_artistico" type="text" class="form-control" maxlength="120" aria-describedby="dica-nome-artistico" value="<%= participante.nome_artistico || '' %>">
    <div id="dica-nome-artistico" class="form-text">Quando preenchido, aparece no lugar do nome na programação.</div>
  </div>
</div>

<div class="mb-3">
  <label for="categoria" class="form-label fw-semibold">Categoria *</label>
  <select id="categoria" name="categoria" class="form-select" required>
    <option value="">Selecione uma categoria</option>
    <% categorias.forEach((categoria) => { %>
      <option value="<%= categoria %>"<%= participante.categoria === categoria ? ' selected' : '' %>><%= categoria %></option>
    <% }) %>
  </select>
</div>

<div class="mb-3">
  <label for="descricao" class="form-label fw-semibold">Descrição</label>
  <textarea id="descricao" name="descricao" class="form-control" rows="4" maxlength="1000"><%= participante.descricao || '' %></textarea>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-6">
    <label for="instagram" class="form-label fw-semibold">Instagram</label>
    <input id="instagram" name="instagram" type="text" class="form-control" maxlength="200" aria-describedby="dica-instagram" value="<%= participante.instagram || '' %>">
    <div id="dica-instagram" class="form-text">Informe @usuario ou o link do perfil.</div>
  </div>
  <div class="col-md-6">
    <label for="youtube" class="form-label fw-semibold">YouTube</label>
    <input id="youtube" name="youtube" type="text" class="form-control" maxlength="200" aria-describedby="dica-youtube" value="<%= participante.youtube || '' %>">
    <div id="dica-youtube" class="form-text">Informe @canal ou o link do canal.</div>
  </div>
</div>
