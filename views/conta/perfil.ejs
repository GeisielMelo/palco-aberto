<%- include('../layouts/topo') %>

<div class="row">
  <div class="col-lg-8">
    <h1 class="mb-2"><%= titulo %></h1>
    <p class="text-body-secondary mb-4">
      <%= perfilExiste
        ? 'Mantenha as suas informações atualizadas. Elas aparecem na sua página pública e na programação.'
        : 'Preencha os dados abaixo para aparecer na lista de participantes. A equipe do evento cuida da programação e dos horários.' %>
    </p>

    <%- include('../partials/erros') %>

    <form method="post" action="/conta/perfil" class="card shadow-sm">
      <div class="card-body p-3 p-md-4">
        <p class="form-text mt-0 mb-3">Campos marcados com * são obrigatórios.</p>

        <%- include('../partials/campos-participante') %>

        <div class="d-grid gap-2 d-sm-flex">
          <button type="submit" class="btn btn-primary"><%= perfilExiste ? 'Salvar alterações' : 'Criar perfil' %></button>
          <a class="btn btn-outline-secondary" href="/conta">Cancelar</a>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/rodape') %>
