<%- include('../../layouts/topo') %>

<div class="row">
  <div class="col-lg-8">
    <h1 class="mb-1"><%= titulo %></h1>
    <p class="text-body-secondary mb-4"><%= alvo.nome %>, <span class="text-break"><%= alvo.email %></span></p>

    <%- include('../../partials/erros') %>

    <form method="post" action="/admin/usuarios/<%= alvo.id %>/editar" class="card shadow-sm">
      <div class="card-body p-3 p-md-4">
        <fieldset class="mb-4">
          <legend class="form-label fw-semibold fs-6">Papel</legend>
          <div class="form-check mb-2">
            <input class="form-check-input" type="radio" name="papel" id="papel-padrao" value="<%= PAPEIS.PADRAO %>"<%= valores.papel === PAPEIS.PADRAO ? ' checked' : '' %> aria-describedby="dica-padrao">
            <label class="form-check-label" for="papel-padrao"><%= ROTULOS_PAPEIS[PAPEIS.PADRAO] %></label>
            <div id="dica-padrao" class="form-text mt-0">Acessa o site e pode criar o próprio perfil de artista.</div>
          </div>
          <div class="form-check mb-2">
            <input class="form-check-input" type="radio" name="papel" id="papel-participante" value="<%= PAPEIS.PARTICIPANTE %>"<%= valores.papel === PAPEIS.PARTICIPANTE ? ' checked' : '' %> aria-describedby="dica-participante">
            <label class="form-check-label" for="papel-participante"><%= ROTULOS_PAPEIS[PAPEIS.PARTICIPANTE] %></label>
            <div id="dica-participante" class="form-text mt-0">Edita o próprio perfil de artista e acompanha as suas apresentações.</div>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="papel" id="papel-admin" value="<%= PAPEIS.ADMIN %>"<%= valores.papel === PAPEIS.ADMIN ? ' checked' : '' %> aria-describedby="dica-admin">
            <label class="form-check-label" for="papel-admin"><%= ROTULOS_PAPEIS[PAPEIS.ADMIN] %></label>
            <div id="dica-admin" class="form-text mt-0">Gerencia eventos, participantes, apresentações e usuários.</div>
          </div>
        </fieldset>

        <div class="mb-4">
          <label for="participante_id" class="form-label fw-semibold">Perfil de artista vinculado</label>
          <select id="participante_id" name="participante_id" class="form-select" aria-describedby="dica-vinculo">
            <option value="">Nenhum perfil vinculado</option>
            <% perfisDisponiveis.forEach((perfil) => { %>
              <option value="<%= perfil.id %>"<%= String(valores.participante_id) === String(perfil.id) ? ' selected' : '' %>><%= perfil.exibicao %> (<%= perfil.categoria %>)</option>
            <% }) %>
          </select>
          <div id="dica-vinculo" class="form-text">Usado apenas quando o papel é Participante. Perfis já vinculados a outras contas não aparecem na lista.</div>
        </div>

        <div class="d-grid gap-2 d-sm-flex">
          <button type="submit" class="btn btn-primary">Salvar acesso</button>
          <a class="btn btn-outline-secondary" href="/admin/usuarios">Cancelar</a>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('../../layouts/rodape') %>
