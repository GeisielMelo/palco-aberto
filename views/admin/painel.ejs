<%- include('../layouts/topo') %>

<h1 class="mb-2">Painel administrativo</h1>
<p class="lead text-body-secondary mb-4">Gerencie os eventos, a programação e o acesso de quem usa o Palco Aberto.</p>

<%
  const indicadores = [
    { titulo: 'Eventos', total: totais.eventos, lista: '/admin/eventos', novo: '/admin/eventos/novo', textoNovo: 'Novo evento' },
    { titulo: 'Participantes', total: totais.participantes, lista: '/admin/participantes', novo: '/admin/participantes/novo', textoNovo: 'Novo participante' },
    { titulo: 'Apresentações', total: totais.apresentacoes, lista: '/admin/apresentacoes', novo: '/admin/apresentacoes/nova', textoNovo: 'Nova apresentação' },
    { titulo: 'Usuários', total: totais.usuarios, lista: '/admin/usuarios', novo: null, textoNovo: null }
  ];
%>

<ul class="list-unstyled row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-0">
  <% indicadores.forEach((indicador) => { %>
    <li class="col">
      <div class="card h-100 shadow-sm">
        <div class="card-body d-flex flex-column">
          <h2 class="h6 text-uppercase text-body-secondary fw-bold"><%= indicador.titulo %></h2>
          <p class="display-5 fw-bold text-primary-emphasis mb-3"><%= indicador.total %></p>
          <div class="d-grid gap-2 mt-auto">
            <a class="btn btn-primary" href="<%= indicador.lista %>">Gerenciar <%= indicador.titulo.toLowerCase() %></a>
            <% if (indicador.novo) { %>
              <a class="btn btn-outline-primary" href="<%= indicador.novo %>"><%= indicador.textoNovo %></a>
            <% } %>
          </div>
        </div>
      </div>
    </li>
  <% }) %>
</ul>

<%- include('../layouts/rodape') %>
