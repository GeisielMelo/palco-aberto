<%- include('../../layouts/topo') %>

<div class="row">
  <div class="col-lg-8">
    <h1 class="mb-3"><%= titulo %></h1>

    <%- include('../../partials/erros') %>

    <form method="post" action="<%= acao %>" class="card shadow-sm">
      <div class="card-body p-3 p-md-4">
        <p class="form-text mt-0 mb-3">Campos marcados com * são obrigatórios.</p>

        <div class="mb-3">
          <label for="nome" class="form-label fw-semibold">Nome do evento *</label>
          <input id="nome" name="nome" type="text" class="form-control" maxlength="120" required value="<%= evento.nome || '' %>">
        </div>

        <div class="row g-3 mb-3">
          <div class="col-sm-5">
            <label for="data" class="form-label fw-semibold">Data *</label>
            <input id="data" name="data" type="date" class="form-control" required value="<%= evento.data || '' %>">
          </div>
          <div class="col-sm-7">
            <label for="local" class="form-label fw-semibold">Local *</label>
            <input id="local" name="local" type="text" class="form-control" maxlength="120" required value="<%= evento.local || '' %>">
          </div>
        </div>

        <div class="mb-4">
          <label for="descricao" class="form-label fw-semibold">Descrição</label>
          <textarea id="descricao" name="descricao" class="form-control" rows="4" maxlength="1000"><%= evento.descricao || '' %></textarea>
        </div>

        <div class="d-grid gap-2 d-sm-flex">
          <button type="submit" class="btn btn-primary">Salvar evento</button>
          <a class="btn btn-outline-secondary" href="/admin/eventos">Cancelar</a>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('../../layouts/rodape') %>
